    {
      "rule_id": "waiting_or_cooling_period_misstatement", "version": "1", "category": "waiting_cooling_period", "severity": "high", "signal_strength": "strong",
      "positive_patterns": ["没[\\s]*有[\\s]*等[\\s]*待[\\s]*期", "犹[\\s]*豫[\\s]*期[\\s]*后[^。；！？]{0,8}全[\\s]*额[\\s]*退[\\s]*费", "生[\\s]*效[\\s]*当[\\s]*天[\\s]*所[\\s]*有[\\s]*疾[\\s]*病[\\s]*都[\\s]*赔", "随[\\s]*时[\\s]*无[\\s]*条[\\s]*件[\\s]*撤[\\s]*销[\\s]*合[\\s]*同"],
      "exception_patterns": ["以[\\s]*合[\\s]*同[\\s]*约[\\s]*定[\\s]*为[\\s]*准"], "required_context_patterns": [],
      "retrieval_queries": ["保险 等待期 犹豫期 退费"], "preferred_record_types": ["regulation", "penalty", "product_document"], "evidence_requirements": ["normative_basis", "product_term_context"],
      "evidence_matchers": {"normative_basis":{"allowed_chunk_kinds":["article_text"],"required_any_patterns":["等待期|犹豫期|退费|撤销|解除合同"],"required_evidence_fields":["article_text"]},"product_term_context":{"allowed_chunk_kinds":["terms_and_risks"],"required_any_patterns":["等待期|犹豫期|退费|撤销"],"required_evidence_fields":["waiting_period","cooling_off_period"]}},
      "explanation_template": "该表述可能错误描述等待期、犹豫期或合同撤销条件。", "review_question_template": "等待期、犹豫期和退费条件是否与正式条款一致？", "institution_remediation_template": "按正式条款准确披露等待期和犹豫期。", "consumer_notice_template": "投保前应核对等待期、犹豫期及退费条件。"
    }
  ]

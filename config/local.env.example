# 保销智审本地正式运行配置。首次启动会复制为 config/local.env；该文件不得提交或分发。
APP_ENV=release
LOG_LEVEL=INFO
FINAL_DEMO_PORT=8000
FINAL_DATABASE_NAME=baoxiao_contest_final
FINAL_DATABASE_HOST=127.0.0.1
FINAL_DATABASE_PORT=5432
FINAL_DATABASE_URL=postgresql+psycopg://${USER}@${FINAL_DATABASE_HOST}:${FINAL_DATABASE_PORT}/baoxiao_contest_final

# DeepSeek / OpenAI-compatible Provider。API key 只写入本机 config/local.env。
LLM_ENABLED=true
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30

# 最终架构使用 Semantic Parser；旧 M7 semantic screening 必须保持关闭。
SEMANTIC_PARSER_ENABLED=true
SEMANTIC_SCREENING_ENABLED=false

EMBEDDING_ENABLED=false
EMBEDDING_PROVIDER=disabled
EMBEDDING_MODEL=
OCR_ENABLED=false
OCR_PROVIDER=disabled

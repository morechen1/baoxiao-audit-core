# 保销智审本地正式运行配置。首次启动会复制为 config/local.env；该文件不得提交或分发。
APP_ENV=release
LOG_LEVEL=INFO
FINAL_DEMO_PORT=${FINAL_DEMO_PORT:-8888}
FINAL_DATABASE_NAME=${FINAL_DATABASE_NAME:-baoxiao_contest_final}
FINAL_DATABASE_HOST=${FINAL_DATABASE_HOST:-127.0.0.1}
FINAL_DATABASE_PORT=${FINAL_DATABASE_PORT:-5432}
FINAL_DATABASE_URL=${FINAL_DATABASE_URL:-postgresql+psycopg://${USER}@${FINAL_DATABASE_HOST}:${FINAL_DATABASE_PORT}/baoxiao_contest_final}

# DeepSeek / OpenAI-compatible Provider。API key 只写入本机 config/local.env。
LLM_ENABLED=true
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30

# 最终架构使用 Semantic Parser；旧 M7 semantic screening 必须保持关闭。
SEMANTIC_PARSER_ENABLED=true
SEMANTIC_SCREENING_ENABLED=false

# 平台接入边界。不会改变 V1 detector 的 taxonomy、Prompt、validator 或阈值。
MAX_UPLOAD_BYTES=10485760
MAX_BATCH_ITEMS=20
PLATFORM_BATCH_CONCURRENCY=3
PLATFORM_LONG_CHUNK_CHARS=90000
PLATFORM_LONG_CHUNK_OVERLAP=240
PLATFORM_MAX_DOCUMENT_CHUNKS=32
SEMANTIC_PARSER_CACHE_ENABLED=true
SEMANTIC_PARSER_CACHE_ENTRIES=256

EMBEDDING_ENABLED=false
EMBEDDING_PROVIDER=disabled
EMBEDDING_MODEL=
OCR_ENABLED=false
OCR_PROVIDER=disabled
